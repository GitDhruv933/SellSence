diff --git a/frontend-vendor/src/components/VendorReviews.tsx b/frontend-vendor/src/components/VendorReviews.tsx
new file mode 100644
index 0000000..04442ae
--- /dev/null
+++ b/frontend-vendor/src/components/VendorReviews.tsx
@@ -0,0 +1,177 @@
+import { useEffect, useState } from 'react';
+import { Star, Loader2, AlertTriangle, MessageSquareReply, Send } from 'lucide-react';
+import { ApiError, reviewsApi } from '@/api/client';
+import type { VendorReview } from '@/api/types';
+
+// The plain reviews inbox - separate from Word Analysis (phrase mining) and
+// Smart Pricing (quality-signal detection), which both read this same
+// review data but only ever show a derived summary. This is just: here's
+// what people rated and wrote, in order, with a place to reply.
+
+function Stars({ rating }: { rating: number }) {
+  return (
+    <div className="flex items-center gap-0.5">
+      {[1, 2, 3, 4, 5].map((n) => (
+        <Star key={n} className={`w-3.5 h-3.5 ${n <= rating ? 'fill-accent-400 text-accent-400' : 'text-gray-200 dark:text-gray-600'}`} />
+      ))}
+    </div>
+  );
+}
+
+function ReplyBox({ review, onSaved }: { review: VendorReview; onSaved: (updated: VendorReview) => void }) {
+  const [open, setOpen] = useState(false);
+  const [text, setText] = useState(review.vendor_reply || '');
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState('');
+
+  const save = async () => {
+    setSaving(true);
+    setError('');
+    try {
+      const updated = await reviewsApi.reply(review.id, text);
+      onSaved(updated);
+      setOpen(false);
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : 'Could not save your reply');
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  if (!open) {
+    return review.vendor_reply ? (
+      <div className="mt-2 ml-2 pl-2.5 border-l-2 border-accent-200 dark:border-accent-800">
+        <p className="text-xs font-semibold text-accent-700 dark:text-accent-400">Your reply</p>
+        <p className="text-sm text-gray-600 dark:text-gray-300">{review.vendor_reply}</p>
+        <button
+          onClick={() => setOpen(true)}
+          className="text-xs font-medium text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 mt-1"
+        >
+          Edit reply
+        </button>
+      </div>
+    ) : (
+      <button
+        onClick={() => setOpen(true)}
+        className="flex items-center gap-1 text-xs font-semibold text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 mt-2"
+      >
+        <MessageSquareReply size={13} />
+        Reply
+      </button>
+    );
+  }
+
+  return (
+    <div className="mt-2 p-3 bg-gray-50 dark:bg-gray-900 rounded-xl">
+      <textarea
+        value={text}
+        onChange={(e) => setText(e.target.value)}
+        placeholder="Write a public reply to this review..."
+        rows={2}
+        className="w-full px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-600 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100 text-sm outline-none focus:ring-2 focus:ring-accent-200 resize-none"
+      />
+      {error && <p className="text-xs font-semibold text-red-600 dark:text-red-400 mt-1">{error}</p>}
+      <div className="flex items-center gap-2 mt-2">
+        <button
+          onClick={save}
+          disabled={saving}
+          className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-accent-500 hover:bg-accent-600 text-white text-xs font-semibold disabled:opacity-60"
+        >
+          {saving ? <Loader2 size={13} className="animate-spin" /> : <Send size={13} />}
+          Save reply
+        </button>
+        <button
+          onClick={() => {
+            setOpen(false);
+            setText(review.vendor_reply || '');
+          }}
+          className="px-3 py-1.5 rounded-lg text-gray-500 dark:text-gray-400 text-xs font-medium hover:bg-gray-100 dark:hover:bg-gray-700"
+        >
+          Cancel
+        </button>
+      </div>
+    </div>
+  );
+}
+
+export default function VendorReviews() {
+  const [reviews, setReviews] = useState<VendorReview[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+
+  const load = () => {
+    setLoading(true);
+    setError(null);
+    reviewsApi
+      .mine()
+      .then((data) => setReviews(data.reviews))
+      .catch((err) => setError(err instanceof ApiError ? err.message : 'Could not load reviews'))
+      .finally(() => setLoading(false));
+  };
+
+  useEffect(load, []);
+
+  const updateOne = (updated: VendorReview) => {
+    setReviews((prev) => prev.map((r) => (r.id === updated.id ? { ...r, ...updated } : r)));
+  };
+
+  const avg = reviews.length ? reviews.reduce((s, r) => s + r.rating, 0) / reviews.length : 0;
+
+  return (
+    <div className="space-y-4">
+      <div className="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-soft p-4">
+        <h2 className="font-semibold text-gray-800 dark:text-gray-100 mb-1">Reviews</h2>
+        <p className="text-xs text-gray-500 dark:text-gray-400">
+          Everything customers have rated and written about your products, newest first.
+        </p>
+      </div>
+
+      {!loading && reviews.length > 0 && (
+        <div className="grid grid-cols-2 gap-3">
+          <div className="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-soft p-3 text-center">
+            <div className="text-2xl font-bold text-gray-800 dark:text-gray-100">{avg.toFixed(1)}</div>
+            <div className="text-xs text-gray-500 dark:text-gray-400">average rating</div>
+          </div>
+          <div className="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-soft p-3 text-center">
+            <div className="text-2xl font-bold text-gray-800 dark:text-gray-100">{reviews.length}</div>
+            <div className="text-xs text-gray-500 dark:text-gray-400">total reviews</div>
+          </div>
+        </div>
+      )}
+
+      {error && (
+        <div className="flex items-center gap-2 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 text-sm rounded-lg p-3">
+          <AlertTriangle size={16} /> {error}
+        </div>
+      )}
+
+      {loading ? (
+        <div className="flex items-center gap-2 text-sm text-gray-400 dark:text-gray-500 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-soft p-4">
+          <Loader2 size={16} className="animate-spin" /> Loading reviews...
+        </div>
+      ) : reviews.length === 0 ? (
+        <p className="text-sm text-gray-400 dark:text-gray-500 italic bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-soft p-4">
+          No reviews yet - they'll show up here once customers start rating delivered orders.
+        </p>
+      ) : (
+        <div className="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-soft p-4">
+          <ul className="space-y-3">
+            {reviews.map((r) => (
+              <li key={r.id} className="border-b border-gray-50 dark:border-gray-700 last:border-0 pb-3 last:pb-0">
+                <div className="flex items-center justify-between gap-2 mb-1">
+                  <span className="text-sm font-semibold text-gray-800 dark:text-gray-100">{r.product_name}</span>
+                  <Stars rating={r.rating} />
+                </div>
+                <p className="text-xs text-gray-400 dark:text-gray-500 mb-1">
+                  {r.customer_name} · {new Date(r.created_at).toLocaleDateString()}
+                </p>
+                {r.comment && <p className="text-sm text-gray-600 dark:text-gray-300">{r.comment}</p>}
+                <ReplyBox review={r} onSaved={updateOne} />
+              </li>
+            ))}
+          </ul>
+        </div>
+      )}
+    </div>
+  );
+}
