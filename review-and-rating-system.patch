+// GET /reviews/mine - every review left on the calling vendor's products,
+// newest first. The plain "read what people said" inbox - separate from
+// Word Analysis (phrase mining) and Smart Pricing (quality-signal
+// detection), which both read this same table but only ever show a
+// derived summary, never the raw list.
+router.get('/mine', (req, res) => {
+  const rows = db
+    .prepare(
+      `SELECT r.id, r.rating, r.comment, r.created_at, r.vendor_reply, r.vendor_reply_at,
+              r.product_id, p.name AS product_name, u.name AS customer_name
+       FROM reviews r
+       JOIN products p ON p.id = r.product_id
+       JOIN users u ON u.id = r.customer_id
+       WHERE r.vendor_id = ?
+       ORDER BY r.created_at DESC`
+    )
+    .all(req.userId);
+  res.json({ reviews: rows });
+});
+
+// PUT /reviews/:id/reply { reply } - a vendor's public reply to one review
+// on their own product. Empty string clears a previously-set reply.
+router.put('/:id/reply', (req, res) => {
+  const review = db.prepare('SELECT * FROM reviews WHERE id = ? AND vendor_id = ?').get(req.params.id, req.userId);
+  if (!review) return res.status(404).json({ error: 'Review not found' });
+
+  const reply = String(req.body?.reply || '').trim().slice(0, 500);
+  db.prepare(
+    `UPDATE reviews SET vendor_reply = ?, vendor_reply_at = CASE WHEN ? = '' THEN NULL ELSE datetime('now') END WHERE id = ?`
+  ).run(reply || null, reply, req.params.id);
+
+  res.json(db.prepare('SELECT * FROM reviews WHERE id = ?').get(req.params.id));
+});
+
 module.exports = router;
