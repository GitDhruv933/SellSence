index 0000000..dd3a05a
--- /dev/null
+++ b/frontend-customer/src/components/ProductDetailDrawer.tsx
@@ -0,0 +1,208 @@
+import { useEffect, useState } from 'react';
+import { X, Star, Loader2, Plus, Check, MessageSquareText, Store } from 'lucide-react';
+import type { Product } from '@/types';
+import type { ProductReviewSummary, ReviewableItem } from '@/api/types';
+import { reviewApi } from '@/api/client';
+import { useAuth } from '@/context/AuthContext';
+import ReviewForm from './ReviewForm';
+
+interface ProductDetailDrawerProps {
+  product: Product | null;
+  onClose: () => void;
+  onAddToCart: (product: Product) => void;
+}
+
+// Opens when a product card is tapped. The star badge on the card only
+// ever showed the average - this is where a customer actually reads what
+// people wrote, and (if they've bought and received this exact item)
+// leaves their own review right from the product instead of having to
+// remember it's buried in My Orders.
+export default function ProductDetailDrawer({ product, onClose, onAddToCart }: ProductDetailDrawerProps) {
+  const { user } = useAuth();
+  const [summary, setSummary] = useState<ProductReviewSummary | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [reviewableMatch, setReviewableMatch] = useState<ReviewableItem | null>(null);
+  const [added, setAdded] = useState(false);
+
+  const open = !!product;
+
+  useEffect(() => {
+    if (!product) return;
+    setLoading(true);
+    setSummary(null);
+    setReviewableMatch(null);
+
+    const loaders: Promise<void>[] = [reviewApi.forProduct(product.id).then(setSummary)];
+
+    // Only a logged-in customer can have a delivered order to review - and
+    // this list is small (their own pending reviews), so it's cheap to
+    // check on every open rather than plumbing eligibility through props.
+    if (user) {
+      loaders.push(
+        reviewApi.reviewable().then((items) => {
+          const match = items.find((i) => String(i.product_id) === product.id);
+          setReviewableMatch(match || null);
+        })
+      );
+    }
+
+    Promise.all(loaders).finally(() => setLoading(false));
+  }, [product, user]);
+
+  const handleAdd = () => {
+    if (!product) return;
+    onAddToCart(product);
+    setAdded(true);
+    setTimeout(() => setAdded(false), 1200);
+  };
+
+  const refreshAfterReview = () => {
+    if (!product) return;
+    setReviewableMatch(null);
+    reviewApi.forProduct(product.id).then(setSummary);
+  };
+
+  return (
+    <>
+      <div
+        className={`fixed inset-0 bg-black/30 z-50 transition-opacity duration-300 ${
+          open ? 'opacity-100' : 'opacity-0 pointer-events-none'
+        }`}
+        onClick={onClose}
+      />
+
+      <div
+        className={`fixed top-0 right-0 bottom-0 w-full max-w-md bg-white z-50 shadow-float flex flex-col transition-transform duration-300 ${
+          open ? 'translate-x-0' : 'translate-x-full'
+        }`}
+      >
+        {product && (
+          <>
+            <div className="flex items-center justify-between px-5 py-4 border-b border-gray-100 shrink-0">
+              <h3 className="font-display font-bold text-base text-gray-900 truncate pr-2">{product.name}</h3>
+              <button
+                onClick={onClose}
+                className="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors shrink-0"
+              >
+                <X className="w-4 h-4 text-gray-600" />
+              </button>
+            </div>
+
+            <div className="flex-1 overflow-y-auto scrollbar-thin">
+              <div className="p-5 space-y-4">
+                <div className="flex gap-3">
+                  <img
+                    src={product.image}
+                    alt={product.name}
+                    className="w-20 h-20 rounded-xl object-cover flex-shrink-0 bg-gray-50"
+                  />
+                  <div className="min-w-0">
+                    <p className="flex items-center gap-1 text-xs text-gray-400 font-medium mb-1">
+                      <Store className="w-3 h-3" /> {product.vendorName}
+                    </p>
+                    <div className="flex items-baseline gap-1.5 mb-1">
+                      <span className="font-display font-extrabold text-lg text-gray-900">₹{product.price}</span>
+                      <span className="text-xs text-gray-400 font-medium">/ {product.unit}</span>
+                    </div>
+                    {summary && summary.count > 0 ? (
+                      <div className="flex items-center gap-1">
+                        <Star className="w-3.5 h-3.5 fill-accent-400 text-accent-400" />
+                        <span className="text-xs font-bold text-gray-700">{summary.average}</span>
+                        <span className="text-[11px] text-gray-400">
+                          ({summary.count} review{summary.count === 1 ? '' : 's'})
+                        </span>
+                      </div>
+                    ) : (
+                      !loading && <span className="text-[11px] text-gray-400 font-medium">No reviews yet</span>
+                    )}
+                  </div>
+                </div>
+
+                <button
+                  onClick={handleAdd}
+                  disabled={product.stock === 0}
+                  className={`w-full flex items-center justify-center gap-2 py-3 rounded-2xl font-semibold text-sm shadow-soft transition-all active:scale-[0.98] ${
+                    added ? 'bg-primary-500 text-white' : 'bg-primary-600 hover:bg-primary-700 text-white'
+                  } ${product.stock === 0 ? 'opacity-40 cursor-not-allowed' : ''}`}
+                >
+                  {added ? <Check className="w-4 h-4" /> : <Plus className="w-4 h-4" />}
+                  {added ? 'Added to cart' : product.stock === 0 ? 'Out of stock' : 'Add to cart'}
+                </button>
+
+                <div className="border-t border-gray-100 pt-4">
+                  <h4 className="flex items-center gap-1.5 font-semibold text-sm text-gray-800 mb-3">
+                    <MessageSquareText className="w-4 h-4 text-gray-400" />
+                    Reviews
+                  </h4>
+
+                  {loading ? (
+                    <div className="flex items-center justify-center py-8 text-gray-400">
+                      <Loader2 className="w-5 h-5 animate-spin" />
+                    </div>
+                  ) : (
+                    <>
+                      {reviewableMatch && (
+                        <div className="mb-3">
+                          <p className="text-xs font-semibold text-primary-700 mb-1">You bought this - how was it?</p>
+                          <ReviewForm
+                            orderId={reviewableMatch.order_id}
+                            productId={reviewableMatch.product_id}
+                            onDone={refreshAfterReview}
+                          />
+                        </div>
+                      )}
+
+                      {!user && (
+                        <p className="text-xs text-gray-400 italic mb-3">
+                          Buy this item and, once it's delivered, you can come back here to leave a review.
+                        </p>
+                      )}
+
+                      {summary && summary.reviews.length > 0 ? (
+                        <ul className="space-y-3">
+                          {summary.reviews.map((r) => (
+                            <li key={r.id} className="border-b border-gray-50 last:border-0 pb-3 last:pb-0">
+                              <div className="flex items-center justify-between mb-1">
+                                <span className="text-sm font-semibold text-gray-800">{r.customer_name}</span>
+                                <div className="flex items-center gap-0.5">
+                                  {[1, 2, 3, 4, 5].map((n) => (
+                                    <Star
+                                      key={n}
+                                      className={`w-3 h-3 ${
+                                        n <= r.rating ? 'fill-accent-400 text-accent-400' : 'text-gray-200'
+                                      }`}
+                                    />
+                                  ))}
+                                </div>
+                              </div>
+                              {r.comment && <p className="text-sm text-gray-600">{r.comment}</p>}
+                              <p className="text-[11px] text-gray-300 mt-0.5">
+                                {new Date(r.created_at).toLocaleDateString()}
+                              </p>
+                              {r.vendor_reply && (
+                                <div className="mt-1.5 ml-2 pl-2.5 border-l-2 border-primary-200">
+                                  <p className="text-[11px] font-semibold text-primary-700">
+                                    Reply from {product.vendorName}
+                                  </p>
+                                  <p className="text-xs text-gray-600">{r.vendor_reply}</p>
+                                </div>
+                              )}
+                            </li>
+                          ))}
+                        </ul>
+                      ) : (
+                        !reviewableMatch && (
+                          <p className="text-sm text-gray-400 italic">Be the first to review this item.</p>
+                        )
+                      )}
+                    </>
+                  )}
+                </div>
+              </div>
+            </div>
+          </>
+        )}
+      </div>
+    </>
+  );
+}
