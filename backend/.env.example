PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
# Optional: enables the smart AI assistant. Get a key from console.anthropic.com
# If left empty, the AI assistant falls back to rule-based tips using the vendor's own data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- SMS gateway (for real OTP delivery) ---
# Leave SMS_PROVIDER unset to use console mode (OTP is returned in the API
# response for local testing — never do this in production).
# Options: twilio | msg91 | fast2sms
SMS_PROVIDER=fast2sms

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (https://control.msg91.com) - popular in India, needs a DLT-approved
# template (flow_id) to send OTP SMS to Indian numbers.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DUKAAN
MSG91_FLOW_ID=

# --- Ward market-expansion analysis (Steps 1-7) ---
# python3 must be on PATH with numpy, scipy, scikit-learn installed
# (pip install numpy scipy scikit-learn --break-system-packages) for
# POST /ward-analysis/classify to work. Override the interpreter path here
# if python3 isn't on PATH or you use a virtualenv.
WARD_PYTHON_BIN=python3

